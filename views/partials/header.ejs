<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@600;700&display=swap">
  <link rel="stylesheet" href="/style.css" />
  <script>
    // Apply the saved or preferred theme before the page paints.
    document.documentElement.dataset.theme =
      localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  </script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4036324652622082"
     crossorigin="anonymous"></script>
</head>
<body>
  <header class="site-header">
    <div class="container header-row">
      <a href="/<%= lang %>/" class="logo" aria-label="nowly">
        <svg class="logo-mark" width="24" height="24" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 42V22a14 14 0 0 1 28 0v6" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round"/><circle class="logo-dot" cx="38" cy="40" r="5"/></svg>
        <span class="logo-word">nowly</span>
      </a>
      <nav class="header-actions">
        <div class="lang-switch" role="group" aria-label="<%= i18n[lang].language_switch %>">
          <a href="/en/" lang="en" <% if (lang === 'en') { %>aria-current="page"<% } %>>EN</a>
          <a href="/pt/" lang="pt" <% if (lang === 'pt') { %>aria-current="page"<% } %>>PT</a>
        </div>
        <button id="theme-toggle" class="theme-btn" type="button" aria-label="<%= i18n[lang].theme_alt %>"
          data-label-dark="<%= i18n[lang].theme_dark %>" data-label-light="<%= i18n[lang].theme_light %>"></button>
      </nav>
    </div>
  </header>
