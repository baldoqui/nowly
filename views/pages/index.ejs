<%- include('../partials/header', { i18n: i18n, lang: lang }); %>

  <main id="content" class="container">
    <% if (articles.length === 0) { %><p><%= no_articles %></p><% } %>

    <% groups.forEach((group, groupIndex) => { %>
      <section class="day">
        <h2 class="day-label"><%= group.label %></h2>
        <% group.articles.forEach((article, index) => { %>
          <article class="story<%= groupIndex === 0 && index === 0 ? ' story--lead' : '' %>">
            <p class="kicker">
              <% if (categoryName(article)) { %><span class="kicker-category"><%= categoryName(article) %></span> · <% } %><%= time(article.publishedAt) %><% if (city(article)) { %> · <%= city(article) %><% } %>
            </p>
            <h3 class="story-title"><a href="/<%= lang %>/<%= article.slug %>"><%= article.title %></a></h3>
            <p class="story-lead"><%= article.lead %></p>
            <% if (sourcesCount(article)) { %>
              <p class="story-sources">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 3 8l9 5 9-5-9-5z"/><path d="m3 13 9 5 9-5"/></svg>
                <%= sourcesCount(article) %>
              </p>
            <% } %>
          </article>
        <% }) %>
      </section>
    <% }) %>
  </main>

<%- include('../partials/footer'); %>
